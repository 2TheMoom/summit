# GenLayer RPC API URL
# Default: https://rpc-bradbury.genlayer.com
NEXT_PUBLIC_GENLAYER_RPC_URL=https://rpc-bradbury.genlayer.com

# GenLayer Network Configuration
NEXT_PUBLIC_GENLAYER_CHAIN_ID=4221
NEXT_PUBLIC_GENLAYER_CHAIN_NAME=GenLayer Bradbury Testnet
NEXT_PUBLIC_GENLAYER_SYMBOL=GEN

# Summit Contract Address
# The address of your deployed Summit contract on GenLayer
NEXT_PUBLIC_CONTRACT_ADDRESS=your_contract_address
